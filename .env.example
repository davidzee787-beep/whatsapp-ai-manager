# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# Google service account JSON path
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Google Calendar ID (use "primary" for your main calendar)
GOOGLE_CALENDAR_ID=primary

# Google Sheets spreadsheet ID (from URL: /spreadsheets/d/SPREADSHEET_ID/edit)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Sheet tab name for meeting data
GOOGLE_SHEET_NAME=Meetings

# WhatsApp / Meta Cloud API credentials
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=testwhat

# OpenAI — for voice note transcription (Whisper)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Supabase — https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
