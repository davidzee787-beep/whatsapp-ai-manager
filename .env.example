# Anthropic API key - get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Path to your Google service account JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Google Calendar ID (use "primary" for your main calendar)
GOOGLE_CALENDAR_ID=primary

# Google Sheets spreadsheet ID (from the URL: /spreadsheets/d/SPREADSHEET_ID/edit)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Sheet name/tab to write meeting data to
GOOGLE_SHEET_NAME=Meetings
